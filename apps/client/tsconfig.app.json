{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    // "bun" added alongside vite/client so the `bun:test` imports in the
    // .test.ts files typecheck. Tests are deliberately left INSIDE this
    // project rather than given their own tsconfig: that way `tsc -b`
    // (and so `bun run build`) typechecks them too, which is the point
    // of having them.
    "types": ["vite/client", "bun"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Path alias, required by shadcn's generated components (they import
       from "@/lib/utils" etc.) -- no baseUrl needed with moduleResolution
       "bundler", paths resolve relative to this file. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
