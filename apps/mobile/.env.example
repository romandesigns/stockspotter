# For a physical device, use the backend machine's LAN or tailnet address
# -- per stockspotter-client-architecture's own decision, the phone is
# expected to join the tailnet directly, so a Tailscale IP (100.x.x.x) is
# the real recommended value, not just a LAN fallback.
#
# Also copy .env.local.example to .env.local and set
# REACT_NATIVE_PACKAGER_HOSTNAME there, not here -- Expo's own env loader
# refuses to start at all with a non-EXPO_PUBLIC_ variable in this file.
EXPO_PUBLIC_WS_URL=ws://192.168.1.100:8787
EXPO_PUBLIC_HTTP_URL=http://192.168.1.100:8788

# Opt-in experimental research lane (IAC / Extreme Momentum), default OFF.
# Left commented out on purpose: with it unset the app opens no second
# socket at all and the two panels render nothing. Only "true" (exactly)
# turns it on -- see apps/mobile/README.md for the full enable procedure
# and what has to be true server-side first.
# EXPO_PUBLIC_EXPERIMENTAL_STRATEGIES=true
